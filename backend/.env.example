# Copiar a backend/.env (no versionar). Ejecutar uvicorn desde backend/.

# Earthdata Login (urs.earthdata.nasa.gov). Harmony autentica con EARTHDATA_USERNAME y EARTHDATA_PASSWORD si ambos están definidos.
# Si no lo están, usa NETRC o, en su defecto, ~/.netrc. Definir solo uno de los dos no surte efecto.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Alternativa: ruta a un netrc con credenciales EDL. Se exporta como NETRC a requests y harmony.
# Solo rige si EARTHDATA_USERNAME y EARTHDATA_PASSWORD no están definidos.
# NETRC=/home/usuario/.netrc

# Carpeta de datos: inventarios, GeoTIFF y ledger SQLite de jobs.
DATA_DIR=data

# Orígenes CORS permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173

# NISAR GCOV recortado en AWS (backend/cloud). Credenciales AWS: cadena por defecto (~/.aws).
NISAR_BUCKET=luz-sideral-nisar-9828
AWS_REGION=us-west-2
